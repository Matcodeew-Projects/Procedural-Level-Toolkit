.panel {
    flex-shrink: 0;
    margin-bottom: 6px;
    background-color: rgb(38, 38, 38);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(58, 58, 58);
    border-right-color: rgb(58, 58, 58);
    border-bottom-color: rgb(58, 58, 58);
    border-left-color: rgb(58, 58, 58);
}

.panel--grow {
    flex-grow: 1;
    min-height: 120px;
}

.panel--inspector {
    flex-grow: 1;
    min-height: 180px;
}

.panel--preview {
    height: 260px;
    min-height: 180px;
}

.panel__header {
    height: 30px;
    min-height: 30px;
    padding-left: 8px;
    padding-right: 6px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(45, 45, 45);
    border-bottom-width: 1px;
    border-bottom-color: rgb(61, 61, 61);
}

.panel__title {
    -unity-font-style: bold;
}

.panel__meta {
    margin-left: 8px;
    color: rgb(131, 131, 131);
    font-size: 10px;
}

.panel__body {
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
}

.panel__body--grow {
    flex-grow: 1;
    min-height: 0;
}

.tool-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.tool-button {
    width: 48%;
    height: 28px;
    margin-right: 2%;
    margin-bottom: 4px;
}

.tool-button--active {
    -unity-font-style: bold;
}

.cell-type-list {
    height: 110px;
    min-height: 70px;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    background-color: rgb(32, 32, 32);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(56, 56, 56);
    border-right-color: rgb(56, 56, 56);
    border-bottom-color: rgb(56, 56, 56);
    border-left-color: rgb(56, 56, 56);
}

.layer-list {
    flex-grow: 1;
    min-height: 80px;
    margin-bottom: 6px;
    background-color: rgb(32, 32, 32);
}

.layer-actions {
    flex-direction: row;
    margin-top: 4px;
}

.layer-actions__wide {
    flex-grow: 1;
}

.layer-actions__half {
    flex-grow: 1;
}

.inspector-scroll {
    flex-grow: 1;
}

.inspector-state {
    flex-grow: 1;
}

.inspector-empty-text {
    margin-top: 18px;
    white-space: normal;
}

.preview-live-toggle {
    margin-left: 4px;
}

.preview-viewport {
    flex-grow: 1;
    min-height: 110px;
    align-items: center;
    justify-content: center;
    background-color: rgb(27, 27, 27);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(54, 54, 54);
    border-right-color: rgb(54, 54, 54);
    border-bottom-color: rgb(54, 54, 54);
    border-left-color: rgb(54, 54, 54);
}

.preview-placeholder {
    color: rgb(87, 87, 87);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.preview-actions {
    flex-direction: row;
    margin-top: 6px;
}

.preview-actions__button {
    flex-grow: 1;
}
