  m_Script: {fileID: 11500000, guid: 2b4fc0ac7f61a8341a0fa9776f88d717, type: 3}
  m_Name: DefaultLevelSample
  m_EditorClassIdentifier: Matcodeew.ProceduralLevelToolkit.Runtime::LevelDefinition
  id: 7738400e915f4696a617530a4ab7b134
  levelName: DefaultLevelSample
  description: "LevelDefault est le niveau de r\xE9f\xE9rence du ProceduralLevelToolkit, con\xE7u pour valider le fonctionnement global du Level Editor. Il combine plusieurs salles et types de couloirs, dont des corridors droits et en L, avec diff\xE9rentes orientations et plusieurs embranchements. Ce niveau sert principalement \xE0 tester la connexion des sockets, le placement automatique des modules, les rotations, la d\xE9tection des chevauchements ainsi que la coh\xE9rence entre le graphe, le layout 2D et la preview 3D."
