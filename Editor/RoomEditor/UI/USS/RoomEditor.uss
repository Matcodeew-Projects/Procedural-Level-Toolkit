.room-editor {
    flex-grow: 1;
    min-width: 720px;
    min-height: 460px;
    background-color: rgb(30, 30, 30);
}

.toolbar {
    height: 38px;
    min-height: 38px;
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
    background-color: rgb(40, 40, 40);
    border-bottom-width: 1px;
    border-bottom-color: rgb(63, 63, 63);
}

.toolbar__identity {
    flex-direction: row;
    align-items: center;
}

.toolbar__title {
    margin-right: 10px;
    color: rgb(225, 225, 225);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.toolbar__room-name {
    color: rgb(172, 172, 172);
}

.toolbar__dirty {
    margin-left: 5px;
    color: rgb(220, 171, 75);
}

.toolbar__separator {
    width: 1px;
    height: 20px;
    margin-left: 8px;
    margin-right: 8px;
    background-color: rgb(68, 68, 68);
}

.toolbar__validation {
    margin-right: 8px;
    font-size: 10px;
}

.room-editor__body {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
}

.sidebar {
    flex-shrink: 0;
    min-height: 0;
    padding-top: 6px;
    padding-right: 6px;
    padding-bottom: 6px;
    padding-left: 6px;
    background-color: rgb(34, 34, 34);
}

.room-editor__split {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.sidebar--left {
    min-width: 170px;
    max-width: 520px;
}

.sidebar--right {
    min-width: 220px;
    max-width: 620px;
}

.right-sidebar__split {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.right-sidebar__pane {
    min-height: 120px;
    min-width: 0;
    overflow: hidden;
}

.workspace {
    flex-grow: 1;
    min-width: 280px;
    min-height: 0;
    flex-direction: column;
}

.workspace__toolbar {
    height: 38px;
    min-height: 38px;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 8px;
    background-color: rgb(36, 36, 36);
    border-bottom-width: 1px;
    border-bottom-color: rgb(53, 53, 53);
}

.workspace__info {
    flex-direction: row;
    align-items: center;
}

.workspace__grid-size {
    margin-left: 8px;
    margin-right: 12px;
    -unity-font-style: bold;
}

.zoom-label {
    width: 48px;
    -unity-text-align: middle-center;
    color: rgb(166, 166, 166);
}

.grid-viewport {
    flex-grow: 1;
    min-height: 0;
    position: relative;
    overflow: hidden;
    background-color: rgb(24, 24, 24);
}

.room-grid-canvas {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.grid-empty-state {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 260px;
    margin-left: -130px;
    margin-top: -30px;
    align-items: center;
}

.grid-empty-state__title {
    margin-bottom: 4px;
    color: rgb(74, 74, 74);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.status-bar {
    height: 22px;
    min-height: 22px;
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
    background-color: rgb(35, 35, 35);
    border-top-width: 1px;
    border-top-color: rgb(56, 56, 56);
    font-size: 10px;
}

    /* ========================================================= */
/* Layers Panel                                              */
/* ========================================================= */

.layer-list {
    margin-top: 6px;
    margin-bottom: 8px;
    min-height: 120px;
    flex-grow: 1;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(52, 52, 52);
    border-right-color: rgb(52, 52, 52);
    border-bottom-color: rgb(52, 52, 52);
    border-left-color: rgb(52, 52, 52);
    background-color: rgb(26, 26, 26);
}

.layer-row {
    flex-direction: row;
    align-items: center;
    height: 28px;
    margin-top: 2px;
    margin-bottom: 2px;
    margin-left: 4px;
    margin-right: 4px;
    padding-left: 0px;
    padding-right: 4px;
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    background-color: rgb(36, 36, 36);
}

.layer-row:hover {
    background-color: rgb(45, 45, 45);
}

.layer-row--active {
    background-color: rgb(42, 58, 82);
}

.layer-row__accent {
    width: 3px;
    height: 22px;
    margin-right: 6px;
    border-top-left-radius: 2px;
    border-bottom-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    background-color: rgb(50, 50, 50);
}

.layer-row__accent--active {
    background-color: rgb(82, 150, 255);
}

.layer-row__state-button {
    width: 24px;
    min-width: 24px;
    height: 22px;
    margin-right: 4px;
    padding-top: 0px;
    padding-bottom: 0px;
    padding-left: 0px;
    padding-right: 0px;
    -unity-text-align: middle-center;
    font-size: 10px;
    color: rgb(210, 210, 210);
    background-color: rgb(58, 58, 58);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(72, 72, 72);
    border-right-color: rgb(72, 72, 72);
    border-bottom-color: rgb(72, 72, 72);
    border-left-color: rgb(72, 72, 72);
}

.layer-row__state-button--on {
    background-color: rgb(64, 110, 164);
    border-top-color: rgb(88, 142, 208);
    border-right-color: rgb(88, 142, 208);
    border-bottom-color: rgb(88, 142, 208);
    border-left-color: rgb(88, 142, 208);
    color: rgb(255, 255, 255);
}

.layer-row__state-button--off {
    background-color: rgb(58, 58, 58);
    color: rgb(175, 175, 175);
}

.layer-row__name-button {
    flex-grow: 1;
    height: 22px;
    margin-left: 2px;
    padding-left: 8px;
    padding-right: 8px;
    -unity-text-align: middle-left;
    color: rgb(222, 222, 222);
    background-color: rgb(47, 47, 47);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(66, 66, 66);
    border-right-color: rgb(66, 66, 66);
    border-bottom-color: rgb(66, 66, 66);
    border-left-color: rgb(66, 66, 66);
}

.layer-row__name-button--active {
    background-color: rgb(68, 90, 122);
    border-top-color: rgb(94, 132, 186);
    border-right-color: rgb(94, 132, 186);
    border-bottom-color: rgb(94, 132, 186);
    border-left-color: rgb(94, 132, 186);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.layer-row__rename-field {
    flex-grow: 1;
    height: 22px;
    margin-left: 2px;
}

.layer-row__rename-field .unity-text-input {
    padding-left: 6px;
    padding-right: 6px;
    color: rgb(235, 235, 235);
    background-color: rgb(28, 28, 28);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(86, 120, 180);
    border-right-color: rgb(86, 120, 180);
    border-bottom-color: rgb(86, 120, 180);
    border-left-color: rgb(86, 120, 180);
}

.layer-toolbar-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 0px;
    gap: 4px;
}

.layer-toolbar-row__main {
    flex-grow: 1;
}

.layer-toolbar-row__half {
    flex-grow: 1;
}

.hidden {
    display: none;
}