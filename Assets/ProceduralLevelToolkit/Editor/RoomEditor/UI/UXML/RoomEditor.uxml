<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd"
         editor-extension-mode="True">

    <ui:Template name="RoomEditorToolbar" src="Toolbar.uxml" />
    <ui:Template name="RoomEditorToolPalette" src="ToolPalette.uxml" />
    <ui:Template name="RoomEditorLayersPanel" src="LayersPanel.uxml" />
    <ui:Template name="RoomEditorInspectorPanel" src="InspectorPanel.uxml" />
    <ui:Template name="RoomEditorPreviewPanel" src="PreviewPanel.uxml" />

    <ui:Style src="../USS/RoomEditorCommon.uss" />
    <ui:Style src="../USS/RoomEditorPanels.uss" />
    <ui:Style src="../USS/RoomEditor.uss" />

    <ui:VisualElement name="room-editor-root" class="room-editor">
        <ui:Instance template="RoomEditorToolbar" />

        <ui:VisualElement name="room-editor-body" class="room-editor__body">

            <!--
                Split 1 : panneau gauche / reste de l'éditeur.
                L'utilisateur peut redimensionner le panneau gauche en glissant
                le séparateur, comme dans les fenêtres natives de Unity.
            -->
            <ui:TwoPaneSplitView name="left-main-split"
                                 class="room-editor__split"
                                 fixed-pane-index="0"
                                 fixed-pane-initial-dimension="230"
                                 orientation="Horizontal">

                <ui:VisualElement name="left-sidebar" class="sidebar sidebar--left">
                    <ui:Instance template="RoomEditorToolPalette" />
                    <ui:Instance template="RoomEditorLayersPanel" />
                </ui:VisualElement>

                <!--
                    Split 2 : workspace / panneau droit.
                    Le deuxième enfant est le panneau fixe afin que le bord droit
                    puisse être tiré vers la gauche ou la droite.
                -->
                <ui:TwoPaneSplitView name="workspace-right-split"
                                     class="room-editor__split"
                                     fixed-pane-index="1"
                                     fixed-pane-initial-dimension="300"
                                     orientation="Horizontal">

                    <ui:VisualElement name="workspace" class="workspace">
                        <ui:VisualElement name="workspace-toolbar" class="workspace__toolbar">
                            <ui:VisualElement class="workspace__info">
                                <ui:Label text="GRID" class="eyebrow" />
                                <ui:Label name="grid-size-label" text="20 × 20" class="workspace__grid-size" />
                                <ui:Label name="active-layer-label" text="Layer: Base" class="text-muted" />
                            </ui:VisualElement>

                            <ui:VisualElement class="spacer" />

                            <ui:Button name="grid-fit-button" text="Fit" class="button button--compact" />
                            <ui:Button name="grid-zoom-out-button" text="−" class="button button--square" />
                            <ui:Label name="grid-zoom-label" text="100%" class="zoom-label" />
                            <ui:Button name="grid-zoom-in-button" text="+" class="button button--square" />
                        </ui:VisualElement>

                        <ui:VisualElement name="grid-viewport" class="grid-viewport">
                            <ui:VisualElement name="room-grid-canvas"
                                              class="room-grid-canvas"
                                              focusable="true" />

                            <ui:VisualElement name="grid-empty-state"
                                              class="grid-empty-state"
                                              picking-mode="Ignore">
                                <ui:Label text="ROOM GRID" class="grid-empty-state__title" />
                                <ui:Label text="The room cells will be drawn here by GridCanvasUI."
                                          class="text-muted text-centered" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement name="right-sidebar" class="sidebar sidebar--right">

                        <!--
                            Split 3 : Inspector / Preview 3D.
                            Celui-ci est vertical afin que la hauteur des deux zones
                            puisse également être réglée à la souris.
                        -->
                        <ui:TwoPaneSplitView name="inspector-preview-split"
                                             class="right-sidebar__split"
                                             fixed-pane-index="0"
                                             fixed-pane-initial-dimension="330"
                                             orientation="Vertical">

                            <ui:VisualElement name="inspector-pane" class="right-sidebar__pane">
                                <ui:Instance template="RoomEditorInspectorPanel" />
                            </ui:VisualElement>

                            <ui:VisualElement name="preview-pane" class="right-sidebar__pane">
                                <ui:Instance template="RoomEditorPreviewPanel" />
                            </ui:VisualElement>

                        </ui:TwoPaneSplitView>
                    </ui:VisualElement>

                </ui:TwoPaneSplitView>
            </ui:TwoPaneSplitView>
        </ui:VisualElement>

        <ui:VisualElement name="status-bar" class="status-bar">
            <ui:Label name="status-message-label" text="Ready" class="text-muted" />
            <ui:VisualElement class="spacer" />
            <ui:Label name="cursor-cell-label" text="Cell: —, —" class="text-muted" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
